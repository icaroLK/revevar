# Copy to .env and fill in real values locally. Never commit .env.

# Base path of the API as seen by the browser
VITE_API_BASE_URL=/api/v1
# Dev only: where the Vite proxy forwards /api (the back end)
VITE_API_PROXY_TARGET=http://localhost:3000
# Dev only: use mock data (MSW) instead of the real API
VITE_USE_MOCKS=true
